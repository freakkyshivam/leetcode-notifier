# ---- Core ----
PORT=3000
MONGODB_URI=mongodb://localhost:27017/leetcode-notifier
TIMEZONE=Asia/Kolkata

# ---- Email (SMTP) — Brevo SMTP or any standard SMTP ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM="LeetCode Notifier <you@example.com>"

# ---- Telegram — shared bot ----
# Create a bot via @BotFather, get the token.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Its @username (no @), shown on the signup page as a clickable link/hint.
TELEGRAM_BOT_USERNAME=your_bot_username

# ---- Browser Push (Web Push / VAPID) ----
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
